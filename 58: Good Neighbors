-- 7 Billion Humans (2235) --
-- 58: Good Neighbors --

a:
b:
c:
step nw,w,sw,n,s,ne,e,se
if c == datacube:
	if nw == worker or
	 n == worker or
	 ne == worker or
	 e == worker or
	 se == worker or
	 s == worker or
	 sw == worker or
	 w == worker:
		jump b
	endif
	mem2 = set 0
	mem1 = foreachdir nw,w,sw,n,s,ne,e,se:
		if mem1 == datacube:
			mem2 = calc mem2 + 1
		endif
	endfor
	if mem2 > 3:
		pickup c
	else:
		jump c
	endif
	d:
	e:
	step nw,w,sw,n,s,ne,e,se
	mem2 = set 0
	if c != nothing:
		jump d
	endif
	mem1 = foreachdir nw,w,sw,n,s,ne,e,se:
		if mem1 == datacube:
			mem2 = calc mem2 + 1
		endif
	endfor
	if mem2 <= 3:
		write mem2
		drop
	else:
		jump e
	endif
endif
jump a


